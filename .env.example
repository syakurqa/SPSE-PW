# ==========================================
# AUTOMATION ENVIRONMENT CONFIG (EXAMPLE)
# ==========================================
ENV=SIT

# E-Katalog Base URLs & Credentials
EKATALOG_BASE_URL=https://ekatalog-sit.example.com
EKATALOG_BASE_URL_SIT=https://ekatalog-sit.example.com
EKATALOG_BASE_URL_UAT=https://ekatalog-uat.example.com
EKATALOG_SIT_USER_BUYER=buyer_test@example.com
EKATALOG_SIT_PASS_BUYER=Password123!
EKATALOG_SIT_USER_VENDOR=vendor_test@example.com
EKATALOG_SIT_PASS_VENDOR=Password123!

# SPSE Base URLs & Credentials
SPSE_BASE_URL=https://spse-sit.example.com
SPSE_BASE_URL_SIT=https://spse-sit.example.com
SPSE_BASE_URL_UAT=https://spse-uat.example.com
SPSE_SIT_USER_VENDOR=vendor_spse@example.com
SPSE_SIT_PASS_VENDOR=Password123!

# Browser & Playwright Options
HEADLESS=false
SLOW_MO=0
VIEWPORT_WIDTH=1470
VIEWPORT_HEIGHT=798

# Database Config
DB_HOST=localhost
DB_PORT=1433
DB_NAME=EKATALOG_DB
DB_USER=sa
DB_PASS=your_password_here

# Reporting Config
ENABLE_SLACK_NOTIF=false
SLACK_WEBHOOK_URL=
