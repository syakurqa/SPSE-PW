# ==========================================
# AUTOMATION ENVIRONMENT CONFIG (EXAMPLE)
# ==========================================
ENV=SIT

# Base URL dan akun utama PPK berada di env.sit.json/env.uat.json.
# Variabel ini digunakan ketika halaman meminta re-login PPK.
SPSE_PPK_USERNAME=<email-ppk>
SPSE_PPK_PASSWORD=<password-ppk>

# Flow 2: Kepala UKPBJ
SPSE_UKPBJ_USERNAME=kepala-ukpbj@example.com
SPSE_UKPBJ_PASSWORD=<password-kepala-ukpbj>
SPSE_PACKAGE_MANIFEST=/absolute/path/to/package-manifest.json
SPSE_OUTPUT_PACKAGE_MANIFEST=/absolute/path/to/package-manifest.json
SPSE_POKJA_NAME=<nama-pokja-exact>
SPSE_POKJA_INDEX=1

# Flow 3: tiga anggota Pokja
SPSE_POKJA_1_USERNAME=pokja-1@example.com
SPSE_POKJA_1_PASSWORD=<password-pokja-1>
SPSE_POKJA_2_USERNAME=pokja-2@example.com
SPSE_POKJA_2_PASSWORD=<password-pokja-2>
SPSE_POKJA_3_USERNAME=pokja-3@example.com
SPSE_POKJA_3_PASSWORD=<password-pokja-3>

# Flow 4-6: Penyedia
SPSE_PROVIDER_USERNAME=penyedia@example.com
SPSE_PROVIDER_PASSWORD=<password-penyedia>

# Browser & Playwright Options
HEADLESS=false
SLOW_MO=0
VIEWPORT_WIDTH=1470
VIEWPORT_HEIGHT=798
SPSE_BROWSER_CHANNEL=chrome
SPSE_GUIDE_CAPTURE=false
SPSE_GUIDE_FLOW=flow-1
SPSE_GUIDE_DIR=/absolute/path/to/screenshots
# Flow 1 Khusus PP (Pengadaan Langsung → Pejabat Pengadaan)
SPSE_PPK_PP_USERNAME=
SPSE_PPK_PP_PASSWORD=
SPSE_PPK_PP_RUP_INDEX=1
