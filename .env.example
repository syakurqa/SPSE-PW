# ==========================================
# AUTOMATION ENVIRONMENT CONFIG (EXAMPLE)
# ==========================================
ENV=SIT

# Base URL dan akun utama PPK berada di env.sit.json/env.uat.json.
# Variabel ini digunakan ketika halaman meminta re-login PPK.
SPSE_PPK_USERNAME=<email-ppk>
SPSE_PPK_PASSWORD=<password-ppk>
# Hanya untuk spec Flow 1 generik; runner canonical tidak membaca keduanya.
# SPSE_METODE_PEMILIHAN=Penunjukan Langsung
# SPSE_JENIS_PENGADAAN=Pengadaan Barang

# Flow 2: Kepala UKPBJ
SPSE_UKPBJ_USERNAME=kepala-ukpbj@example.com
SPSE_UKPBJ_PASSWORD=<password-kepala-ukpbj>
# Runner mengisi manifest otomatis. Aktifkan saat menjalankan/resume spec manual.
# SPSE_PACKAGE_MANIFEST=/absolute/path/to/package-manifest.json
# SPSE_OUTPUT_PACKAGE_MANIFEST=/absolute/path/to/new-package-manifest.json
# Nama exact opsional; jika kosong digunakan index 1-based di bawah.
# SPSE_POKJA_NAME=<nama-pokja-exact>
SPSE_POKJA_INDEX=1

# Flow 3: tiga anggota Pokja
SPSE_POKJA_1_USERNAME=pokja-1@example.com
SPSE_POKJA_1_PASSWORD=<password-pokja-1>
# Opsional; default "Pokja 1".
# SPSE_POKJA_1_DISPLAY_NAME=<nama-pokja-1-di-ui>
SPSE_POKJA_2_USERNAME=pokja-2@example.com
SPSE_POKJA_2_PASSWORD=<password-pokja-2>
SPSE_POKJA_3_USERNAME=pokja-3@example.com
SPSE_POKJA_3_PASSWORD=<password-pokja-3>

# Flow 4-6: Penyedia
SPSE_PROVIDER_USERNAME=penyedia@example.com
SPSE_PROVIDER_PASSWORD=<password-penyedia>
# Opsional; default "ANGSAE BARU".
# SPSE_PROVIDER_DISPLAY_NAME=<nama-penyedia-di-ui>

# Flow 5: Pemberian Penjelasan
# SPSE_FLOW5_SESSION_NUMBER=25
# SPSE_FLOW5_EXPLANATION_TIME=23-08-2026 10:00
# SPSE_FLOW5_QUESTION_COUNT=5
# SPSE_FLOW5_ATTACHMENT_COUNT=2
# SPSE_FLOW5_ATTACHMENT_FILE=/absolute/path/to/attachment.pdf

# Flow 6: Data Kualifikasi dan Penawaran
# Selection: all, none, 0,2, atau [0,2]. Indeks dimulai dari 0.
# SPSE_FLOW6_SESSION_NUMBER=25
# SPSE_FLOW6_OFFER_TIME=24-08-2026 10:00
# SPSE_FLOW6_BUSINESS_PERMITS=all
# SPSE_FLOW6_PERSONNEL=all
# SPSE_FLOW6_EXPERIENCE=all
# SPSE_FLOW6_ONGOING_WORK=all
# SPSE_FLOW6_EQUIPMENT=all
# SPSE_FLOW6_OTHER_REQUIREMENT_FILE=/absolute/path/to/qualification.pdf
# SPSE_FLOW6_VALIDITY_DAYS=90
# SPSE_FLOW6_TECHNICAL_FILE=/absolute/path/to/technical.pdf
# SPSE_FLOW6_PRICE_REQUIREMENT_FILES=["/absolute/path/to/price.pdf",null]
# SPSE_FLOW6_PRICE_BEFORE_VAT=9000000000
# SPSE_FLOW6_VAT_PERCENT=11
# SPSE_FLOW6_TKDN_PERCENT=20

# Browser & Playwright Options
SLOW_MO=0
VIEWPORT_WIDTH=1470
VIEWPORT_HEIGHT=798
# Kosong = Chromium dari `npx playwright install chromium`.
# Isi `chrome` hanya jika Google Chrome terpasang di runner.
SPSE_BROWSER_CHANNEL=
SPSE_GUIDE_CAPTURE=false
# Runner mengganti {flow} menjadi 1 sampai 6. Untuk spec tunggal, isi
# SPSE_GUIDE_FLOW secara langsung bila nama flow khusus diperlukan.
SPSE_GUIDE_FLOW_PATTERN=flow-{flow}
SPSE_GUIDE_DIR=/absolute/path/to/screenshots
# Flow 1 Khusus PP (Pengadaan Langsung → Pejabat Pengadaan)
SPSE_PPK_PP_USERNAME=
SPSE_PPK_PP_PASSWORD=
SPSE_PPK_PP_RUP_INDEX=1
