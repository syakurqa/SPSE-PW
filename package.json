{
  "name": "spse-automation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "workspaceDependencies": {
    "@automation/qa-cli": {
      "@automation/common-module": "*"
    }
  },
  "scripts": {
    "lint:common": "npm run lint --workspace=packages/common-module",
    "lint:spse": "npm run lint --workspace=packages/web-automation",
    "lint:spse:check": "npm run lint:check --workspace=packages/web-automation",
    "lint:spse:fix": "npm run lint:fix --workspace=packages/web-automation",
    "test:spse": "npm run test --workspace=packages/web-automation --",
    "test:spse:flow1-6": "npm run test:flow1-6 --workspace=packages/web-automation --",
    "test:spse:flow6:inspect": "npm run test:flow6:inspect --workspace=packages/web-automation --",
    "test:spse:unit": "npm run test:unit --workspace=packages/web-automation",
    "test:spse:ui": "npm run test:ui --workspace=packages/web-automation --",
    "test:spse:headed": "npm run test:headed --workspace=packages/web-automation --",
    "report:spse": "npm run report --workspace=packages/web-automation",
    "codegen:spse": "npm run codegen --workspace=packages/web-automation",
    "capture:spse-upload": "npm run capture:upload --workspace=packages/web-automation",
    "check:env": "node packages/common-module/utils/helpers/env-mapping-checker.js",
    "qa": "node packages/qa-cli/src/index.js",
    "qa:test": "node packages/qa-cli/src/index.js test spse",
    "qa:report": "node packages/qa-cli/src/index.js report spse",
    "qa:codegen": "node packages/qa-cli/src/index.js codegen",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.23.0",
    "@stylistic/eslint-plugin-js": "^4.2.0",
    "eslint": "^9.23.0",
    "eslint-plugin-check-file": "^3.1.0",
    "globals": "^16.0.0",
    "knex": "^3.1.0",
    "tedious": "^18.6.1"
  },
  "allowScripts": {
    "esbuild@0.27.3": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "edgedriver@6.3.0": true,
    "geckodriver@6.1.0": true
  }
}
